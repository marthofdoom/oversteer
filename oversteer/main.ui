                                <property name="label" translatable="yes">Reset to defaults</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="receives-default">True</property>
                                <property name="valign">center</property>
                                <property name="tooltip-text" translatable="yes">Gain 100, spring and damper 30, friction 30, rumble 50, centering spring 0, games may adjust strength, inertia as damper.</property>
                                <signal name="clicked" handler="on_ffb_reset_clicked" swapped="no"/>
                              </object>
                              <packing>
                                <property name="expand">False</property>
