                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="receives-default">True</property>
                                <property name="valign">center</property>
                                <property name="tooltip-text" translatable="yes">Play this effect on the wheel for two seconds so you can feel what it does. Hands on the wheel.</property>
                                <signal name="clicked" handler="on_try_effect_clicked" swapped="no"/>
