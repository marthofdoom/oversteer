                        <property name="selectable">False</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="tooltip-text" translatable="yes">Games can lower the force feedback strength through their own settings (DirectInput gain). On: their setting multiplies the global strength above. Off: the game's setting is ignored and only the global strength applies — useful when a game keeps resetting its FFB to a weak value.</property>
