                    </child>
<child>
                      <object class="GtkListBoxRow">
                        <property name="height-request">70</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="activatable">False</property>
                        <property name="selectable">False</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="tooltip-text" translatable="yes">Master strength for everything the game sends: road feel, self-aligning torque, kerbs, collisions, engine vibration. 100% is the wheel's full torque. Above 100% weak games get louder but strong effects flatten at the wheel's limit (clipping) and detail is lost there; the FFBmeter shows when that happens.</property>
                            <property name="valign">center</property>
                            <property name="spacing">64</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="halign">start</property>
                                <property name="label" translatable="yes">Global feedback gain</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkScale" id="ff_gain">
                                <property name="width-request">600</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="valign">center</property>
                                <property name="adjustment">ff_gain_adjustment</property>
                                <property name="fill-level">100</property>
                                <property name="show-fill-level">True</property>
                                <property name="restrict-to-fill-level">False</property>
                                <property name="round-digits">0</property>
                                <property name="digits">0</property>
                                <signal name="format-value" handler="format_ff_gain_value" swapped="no"/>
                                <signal name="value-changed" handler="on_ff_gain_value_changed" swapped="no"/>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
