                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="tooltip-text" translatable="yes">Rumble: games written for gamepads send motor rumble instead of wheel forces. The driver turns it into a vibration of the wheel rim (30 Hz for the big motor, 60 Hz for the small one). Set the strength to taste; 0 disables it. Racing sims don't use this.</property>
