                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">Racing equipment found on this computer. Ticked devices are folded into one virtual wheel when combining is on, so games that only talk to one device (force feedback, Forza's "Device 1") see everything at once. The real devices are hidden from games while combined. By default the combined device keeps the wheel's identity; tick the generic option for games like Forza Horizon 6. Games only look for force feedback devices at start-up, so start the game after the combined device exists.</property>
                    <property name="wrap">True</property>
                    <property name="xalign">0</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
