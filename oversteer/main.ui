                        <property name="activatable">False</property>
                        <property name="selectable">False</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="tooltip-text" translatable="yes">Spring: a force that pulls the wheel back to a centre point, stronger the further you turn. Games use it for the tyres' self-aligning torque at speed and for the parked-car weight. This scales how hard the game's springs can pull; too high and the wheel snaps to centre on its own.</property>
