                        <property name="selectable">False</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="tooltip-text" translatable="yes">Damper: resistance that grows with how fast the wheel is turning, like moving through thick oil. Games use it to stop the wheel oscillating and to add weight when moving slowly. Higher values calm the wheel down but make quick corrections feel heavy.</property>
