#!/bin/bash
# oversteer-run: run a Steam game together with Oversteer's shared-memory
# telemetry bridge.
#
# Steam > game > Properties > Launch options:
#     oversteer-run %command%
#
# The game starts exactly as Steam would start it. Alongside it, through
# the same Steam Linux Runtime and Proton and therefore inside the same
# prefix, oversteer-shm-bridge.exe reads the game's shared-memory
# telemetry (Assetto Corsa, Assetto Corsa Competizione, Assetto Corsa
# Rally) and sends the engine RPM to Oversteer's rev lights over UDP.
# Games without shared-memory telemetry are simply run.
#
# Environment: OVERSTEER_TELEMETRY_PORT (default 5300, must match the port
# in Oversteer's Rev lights row), OVERSTEER_SHM_BRIDGE (path to the .exe).
# The bridge writes $XDG_RUNTIME_DIR/oversteer-shm-bridge.log (what it
# found and how much it sent); its launcher's output goes to
# $XDG_RUNTIME_DIR/oversteer-run.log.
#
# This file is part of Oversteer (GPL-3.0-or-later).

here=$(dirname "$(readlink -f "$0")")
bridge=${OVERSTEER_SHM_BRIDGE:-}
for candidate in "$here/../lib/oversteer/oversteer-shm-bridge.exe" \
                 "$here/../data/telemetry/oversteer-shm-bridge.exe" \
                 "$here/oversteer-shm-bridge.exe"; do
    if [ -z "$bridge" ] && [ -f "$candidate" ]; then
        bridge=$(readlink -f "$candidate")
    fi
done
port=${OVERSTEER_TELEMETRY_PORT:-5300}

# Find Proton in the command: everything before it (the runtime entry
# point) is kept, its verb becomes "run" so the bridge doesn't wait for
# the game's wineserver, and the game executable is replaced.
proton_index=-1
for ((i = 1; i <= $#; i++)); do
    case "${!i}" in
        */proton) proton_index=$i; break ;;
    esac
done

if [ "$proton_index" -lt 0 ] || [ -z "$bridge" ]; then
    exec "$@"
fi

bridge_cmd=()
for ((i = 1; i < proton_index; i++)); do
    arg=${!i}
    [ "$arg" = "--verb=waitforexitandrun" ] && arg="--verb=run"
    bridge_cmd+=("$arg")
done
log=${XDG_RUNTIME_DIR:-/tmp}/oversteer-run.log
bridge_log=${XDG_RUNTIME_DIR:-/tmp}/oversteer-shm-bridge.log
: > "$bridge_log"
bridge_cmd+=("${!proton_index}" run "$bridge" --port "$port" --exit-when-gone --log "Z:$bridge_log")

"$@" &
game=$!

# Give the game a moment to create its prefix objects, then start the bridge.
( sleep 8; exec "${bridge_cmd[@]}" ) > "$log" 2>&1 &
bridge_pid=$!

wait "$game"
status=$?
kill "$bridge_pid" 2> /dev/null
# The Windows process outlives its launcher; it also exits by itself once
# the game's telemetry is gone, this just makes it immediate.
pkill -f '^Z:.*oversteer-shm-bridge\.exe' 2> /dev/null
exit "$status"
