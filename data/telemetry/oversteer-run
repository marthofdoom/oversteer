#!/bin/bash
# oversteer-run: run a Steam game together with Oversteer's shared-memory
# telemetry bridge.
#
# Steam > game > Properties > Launch options:
#     oversteer-run %command%
#
# The game starts exactly as Steam would start it. Alongside it, with the
# same Proton and Steam environment and therefore in the same prefix,
# oversteer-shm-bridge.exe reads the game's shared-memory telemetry
# (Assetto Corsa, Assetto Corsa Competizione, Assetto Corsa Rally) and
# sends the engine RPM to Oversteer's rev lights over UDP. Games without
# shared-memory telemetry are simply run.
#
# The bridge is started with Proton directly on the host rather than
# through the Steam Linux Runtime entry point: a second runtime container
# for the same app does not start, while Proton on the host attaches to
# the game's prefix and wineserver.
#
# Environment: OVERSTEER_TELEMETRY_PORT (default 5300, must match the port
# in Oversteer's Rev lights row), OVERSTEER_SHM_BRIDGE (path to the .exe).
# The bridge writes <compatdata>/oversteer-shm-bridge.log next to the
# game's prefix (what it found and how much it sent); its launcher's
# output goes to $XDG_RUNTIME_DIR/oversteer-run.log.
#
# This file is part of Oversteer (GPL-3.0-or-later).

here=$(dirname "$(readlink -f "$0")")
bridge=${OVERSTEER_SHM_BRIDGE:-}
for candidate in "$here/../lib/oversteer/oversteer-shm-bridge.exe" \
                 "$here/../data/telemetry/oversteer-shm-bridge.exe" \
                 "$here/oversteer-shm-bridge.exe"; do
    if [ -z "$bridge" ] && [ -f "$candidate" ]; then
        bridge=$(readlink -f "$candidate")
    fi
done
port=${OVERSTEER_TELEMETRY_PORT:-5300}

# Find Proton in the command; the bridge runs through it with the "run"
# verb (no waiting for the game's wineserver).
proton_index=-1
for ((i = 1; i <= $#; i++)); do
    case "${!i}" in
        */proton) proton_index=$i; break ;;
    esac
done

if [ "$proton_index" -lt 0 ] || [ -z "$bridge" ]; then
    exec "$@"
fi

log=${XDG_RUNTIME_DIR:-/tmp}/oversteer-run.log
if [ -n "$STEAM_COMPAT_DATA_PATH" ] && [ -d "$STEAM_COMPAT_DATA_PATH" ]; then
    bridge_log=$STEAM_COMPAT_DATA_PATH/oversteer-shm-bridge.log
else
    bridge_log=${TMPDIR:-/tmp}/oversteer-shm-bridge.log
fi
: > "$bridge_log"
bridge_cmd=("${!proton_index}" run "$bridge" --port "$port" --exit-when-gone --log "Z:$bridge_log")

"$@" &
game=$!

# The game's Proton is still bringing the prefix up for the first seconds
# and a bridge started then is shut down with it; keep retrying while the
# game runs. The bridge exits 0 by itself once it has seen telemetry and
# it went away (the game quit), anything else is retried.
(
    sleep 15
    while kill -0 "$game" 2> /dev/null; do
        "${bridge_cmd[@]}"
        rc=$?
        echo "oversteer-run: bridge exited with $rc" >&2
        [ "$rc" -eq 0 ] && break
        sleep 10
    done
) > "$log" 2>&1 &
bridge_pid=$!

wait "$game"
status=$?
kill "$bridge_pid" 2> /dev/null
# The Windows process outlives its launcher; it also exits by itself once
# the game's telemetry is gone, this just makes it immediate.
pkill -f '^Z:.*oversteer-shm-bridge\.exe' 2> /dev/null
exit "$status"
